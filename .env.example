# Local prompt planning, Save and Load need no environment variables.
# GEMINI_API_KEY is optional and used only when explicitly running provider tools.
# Leave it unset for local-only use; never put real credentials in this file.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
