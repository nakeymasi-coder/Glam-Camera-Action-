# Local prompt and story planning do not require API keys or environment secrets.
# Firebase authentication uses the existing firebase-applet-config.json unchanged.
# Optional server configuration:
PORT=3000

# Base44 static hosting: use `npm run build:base44` to build only the SPA in dist-base44/.
# That script sets this public, non-secret flag to true so the Drive panel stays
# visible as unavailable/pending without calling Express-only /api/drive routes.
# Leave false for the normal `npm run build` + `npm start` server deployment.
VITE_DRIVE_BACKUP_DISABLED=false

# Optional private, per-user Google Drive backup. Disabled by default.
# Set these SERVER-SIDE only after approval/configuration. Never use a VITE_ prefix.
# Existing Firebase sign-in remains unchanged; its project is pinned independently.
DRIVE_BACKUP_ENABLED=false
DRIVE_BACKUP_SINGLE_INSTANCE=false
DRIVE_BACKUP_ORIGIN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DRIVE_BACKUP_FIREBASE_PROJECT_ID=
DRIVE_BACKUP_STORE_DIR=
DRIVE_BACKUP_ENCRYPTION_KEY=
